{
  "buildCommand": "npm --prefix callforge-ops install --production=false && npm --prefix callforge-ops run build",
  "outputDirectory": "callforge-ops/dist/public",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/calling/auth/email/check-credentials",
      "destination": "/api/calling-auth-email-check"
    },
    {
      "source": "/api/calling/auth/email/verify-otp",
      "destination": "/api/calling-auth-email-verify"
    },
    {
      "source": "/api/health",
      "destination": "/api/health"
    },
    {
      "source": "/api/calling/:match*",
      "destination": "/api/calling?route=:match*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
